# Original Blender UI and renderer with optional systems omitted by the lite preset.
include("${CMAKE_CURRENT_LIST_DIR}/../../../../build_files/cmake/config/blender_lite.cmake")
set(WITH_GHOST_WEB ON CACHE BOOL "" FORCE)
set(WITH_GHOST_X11 OFF CACHE BOOL "" FORCE)
set(WITH_GHOST_WAYLAND OFF CACHE BOOL "" FORCE)
set(WITH_OPENGL_BACKEND OFF CACHE BOOL "" FORCE)
set(WITH_VULKAN_BACKEND OFF CACHE BOOL "" FORCE)
set(WITH_METAL_BACKEND OFF CACHE BOOL "" FORCE)
if(BLENDER_WEB_APPLICATION)
  set(WITH_WEBGPU_BACKEND ON CACHE BOOL "" FORCE)
  set(WITH_PYTHON ON CACHE BOOL "" FORCE)
  set(WITH_PYTHON_INSTALL OFF CACHE BOOL "" FORCE)
  set(WITH_PYTHON_NUMPY OFF CACHE BOOL "" FORCE)
  set(PYTHON_VERSION "3.13" CACHE STRING "" FORCE)
  set(PYTHON_INCLUDE_DIR "${CMAKE_PREFIX_PATH}/include/python3.13" CACHE PATH "" FORCE)
  set(PYTHON_INCLUDE_DIRS "${CMAKE_PREFIX_PATH}/include/python3.13" CACHE STRING "" FORCE)
  set(PYTHON_LIBRARY "${CMAKE_PREFIX_PATH}/lib/libpython3.13.a" CACHE FILEPATH "" FORCE)
  set(PYTHON_LIBPATH "${CMAKE_PREFIX_PATH}/lib" CACHE PATH "" FORCE)
else()
  set(WITH_WEBGPU_BACKEND OFF CACHE BOOL "" FORCE)
  set(WITH_PYTHON OFF CACHE BOOL "" FORCE)
endif()
set(WITH_TBB ON CACHE BOOL "" FORCE)
set(WITH_LIBS_PRECOMPILED OFF CACHE BOOL "" FORCE)
set(WITH_COMPILER_SIMD OFF CACHE BOOL "" FORCE)
set(WITH_CPU_CHECK OFF CACHE BOOL "" FORCE)
set(WITH_GTESTS OFF CACHE BOOL "" FORCE)
set(WITH_HARFBUZZ OFF CACHE BOOL "" FORCE)
set(WITH_FRIBIDI OFF CACHE BOOL "" FORCE)
set(WITH_COMPILER_CCACHE OFF CACHE BOOL "" FORCE)
set(WITH_COMPILER_PRECOMPILED_HEADERS OFF CACHE BOOL "" FORCE)
set(WITH_LINKER_MOLD OFF CACHE BOOL "" FORCE)
set(WITH_LINKER_LLD OFF CACHE BOOL "" FORCE)
set(WITH_UNITY_BUILD OFF CACHE BOOL "" FORCE)
set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
