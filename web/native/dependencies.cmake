# Use genuine installed Wasm libraries, including static transitive dependencies.
find_package(Threads REQUIRED)
find_package(JPEG REQUIRED)
find_package(PNG REQUIRED)
find_package(ZLIB REQUIRED)
find_package(Zstd REQUIRED)
find_package(zstd CONFIG REQUIRED)
find_package(libdeflate CONFIG REQUIRED)
find_package(fmt CONFIG REQUIRED)
find_package(Freetype REQUIRED)
find_package(Brotli REQUIRED)
find_package(openjph CONFIG REQUIRED)
find_package(Imath CONFIG REQUIRED)
find_package(OpenEXR CONFIG REQUIRED)

# TIFF's installed targets use these names but don't import their dependencies.
add_library(Deflate::Deflate ALIAS libdeflate::libdeflate_static)
add_library(ZSTD::ZSTD ALIAS zstd::libzstd_static)
find_package(Tiff CONFIG REQUIRED)
add_library(TIFF::TIFF ALIAS TIFF::tiff)
target_link_libraries(Freetype::Freetype INTERFACE ZLIB::ZLIB ${BROTLI_LIBRARIES})
list(APPEND FREETYPE_LIBRARIES ZLIB::ZLIB)

find_package(OpenColorIO CONFIG REQUIRED)
# OpenImageIO embeds these codecs and exports their static target references.
find_package(WebP CONFIG REQUIRED)
find_package(OpenJPEG CONFIG REQUIRED)
find_package(OpenImageIO CONFIG REQUIRED)
find_package(Eigen3 CONFIG REQUIRED)
find_package(TBB CONFIG REQUIRED)
if(WITH_OPENSUBDIV)
  find_package(OpenSubdiv CONFIG REQUIRED)
  set(OPENSUBDIV_INCLUDE_DIRS ${OpenSubdiv_INCLUDE_DIR})
  set(OPENSUBDIV_LIBRARIES OpenSubdiv::osdCPU_static)
endif()

if(WITH_GMP)
  find_package(GMP REQUIRED)
endif()
if(WITH_MANIFOLD)
  find_package(manifold CONFIG REQUIRED)
endif()
if(WITH_FFTW3)
  find_package(Fftw3 REQUIRED)
endif()
if(WITH_ALEMBIC)
  find_package(Alembic REQUIRED)
endif()
if(WITH_OPENVDB)
  find_package(OpenVDB REQUIRED)
  find_library(WEB_BLOSC_LIBRARY NAMES blosc REQUIRED)
  add_library(Web::OpenVDB STATIC IMPORTED)
  set_target_properties(Web::OpenVDB PROPERTIES
    IMPORTED_LOCATION "${OPENVDB_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${OPENVDB_INCLUDE_DIRS}"
    INTERFACE_COMPILE_DEFINITIONS OPENVDB_STATICLIB
    INTERFACE_LINK_LIBRARIES "${WEB_BLOSC_LIBRARY};zstd::libzstd_static;ZLIB::ZLIB;TBB::tbb")
  set(OPENVDB_LIBRARIES Web::OpenVDB)
endif()
if(WITH_NANOVDB)
  find_package(NanoVDB REQUIRED)
endif()
