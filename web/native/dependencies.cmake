if(WITH_CODEC_SNDFILE)
  find_package(SndFile REQUIRED)
  # All codec archives are Wasm libraries from our root-confined prefix.
  foreach(codec FLAC mp3lame opus vorbisenc vorbis ogg)
    find_library(WEB_AUDIO_${codec} NAMES ${codec} REQUIRED)
    list(APPEND LIBSNDFILE_LIBRARIES "${WEB_AUDIO_${codec}}")
  endforeach()
endif()
if(WITH_CODEC_FFMPEG)
  set(FFMPEG_FIND_COMPONENTS avformat avdevice avfilter avcodec swresample swscale avutil)
  find_package(FFmpeg REQUIRED)
  foreach(codec mp3lame opus theoraenc theoradec theora vorbisenc vorbis ogg vpx x264 aom x265)
    find_library(WEB_MEDIA_${codec} NAMES ${codec} REQUIRED)
    list(APPEND FFMPEG_LIBRARIES "${WEB_MEDIA_${codec}}")
  endforeach()
  list(APPEND FFMPEG_LIBRARIES ZLIB::ZLIB)
endif()

# TIFF's installed targets use these names but don't import their dependencies.
add_library(Deflate::Deflate ALIAS libdeflate::libdeflate_static)
add_library(ZSTD::ZSTD ALIAS zstd::libzstd_static)
find_package(Tiff CONFIG REQUIRED)
add_library(TIFF::TIFF ALIAS TIFF::tiff)
target_link_libraries(Freetype::Freetype INTERFACE ZLIB::ZLIB ${BROTLI_LIBRARIES})
list(APPEND FREETYPE_LIBRARIES ZLIB::ZLIB)

