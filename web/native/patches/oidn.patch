+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "exception.h"
+OIDN_NAMESPACE_BEGIN
+  inline size_t checkedSizeMul(size_t a, size_t b)
+    {
+      if (b && a > std::numeric_limits<size_t>::max() / b)
+        throw Exception(Error::InvalidArgument, "image byte size overflows address space");
+      return a * b;
+    }
+
+  inline size_t checkedSizeAdd(size_t a, size_t b)
+    {
+      if (a > std::numeric_limits<size_t>::max() - b)
+        throw Exception(Error::InvalidArgument, "image byte offset overflows address space");
+      return a + b;
+    }
+
+  inline size_t checkedSizeRoundUp(size_t size, size_t alignment)
+  {
+    return checkedSizeAdd(size, alignment - 1) / alignment * alignment;
+  }
+OIDN_NAMESPACE_END
