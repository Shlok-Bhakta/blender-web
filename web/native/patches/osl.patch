--- a/src/cmake/compiler.cmake
+++ b/src/cmake/compiler.cmake
@@ -64,6 +64,10 @@
     # CLANG_VERSION_STRING.
     set (CMAKE_COMPILER_IS_CLANG 1)
     EXECUTE_PROCESS( COMMAND ${CMAKE_CXX_COMPILER} --version OUTPUT_VARIABLE clang_full_version_string )
+    if (EMSCRIPTEN)
+        # The wrapper reports its SDK version; CMake identifies the underlying Clang.
+        set (clang_full_version_string "clang version ${CMAKE_CXX_COMPILER_VERSION}")
+    endif ()
     if (clang_full_version_string MATCHES "Apple")
         set (CMAKE_CXX_COMPILER_ID "AppleClang")
         set (CMAKE_COMPILER_IS_APPLECLANG 1)
